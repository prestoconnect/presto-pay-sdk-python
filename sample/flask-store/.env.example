# Copy to .env in this folder (gitignored). Exported environment variables win over this file.

PRESTOPAY_ENV=staging
PRESTOPAY_MID=YOUR_STAGING_MID
PRESTOPAY_MRN=YOUR_STAGING_PRESTO_MRN

# Your merchant private key
PRESTOPAY_PRIVATE_KEY_FILE=keys/merchant-key.pem
# Only for an encrypted PEM
PRESTOPAY_PRIVATE_KEY_PASSWORD=

# Presto's staging certificate (.der), as Presto sent it
PRESTOPAY_PUBLIC_KEY_FILE=keys/presto.der

# Presto calls notify_url from its own servers: set this to a public origin (a tunnel such as ngrok), not
# localhost, or webhooks will never arrive. redirect_url uses the same origin.
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_DEFAULT_CURRENCY=MYR
